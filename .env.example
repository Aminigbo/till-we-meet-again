# tillwemeet: every setting, explained. Copy what you need into .env (your computer)
# or .env.production (live server). Values in the real environment override these files.
#
# Load order: environment variables > .env.<NODE_ENV> > .env

# development | production. Production refuses to start without Firebase and real secrets.
NODE_ENV=development
# Port the server listens on (Cloud Run sets this itself).
PORT=3000
# Public address of the site, no trailing slash.
BASE_URL=http://localhost:3000

# ---- Firebase ----
# Project id (Project settings → General).
FIREBASE_PROJECT_ID=
# Service account key: path to the JSON file, the JSON on one line, or the JSON in base64.
# Not needed on Google Cloud (Cloud Run, App Engine), which supplies credentials automatically.
FIREBASE_SERVICE_ACCOUNT=./service-account.json
# Cloud Storage bucket for uploads. Empty = uploads saved on the server's disk under DATA_DIR.
FIREBASE_STORAGE_BUCKET=
# Firebase emulator address, for local development against the emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Folder for the local development store and disk uploads.
DATA_DIR=data

# ---- Security ----
# Random 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts NINs. Never change it after launch, or stored NINs can't be read.
ENCRYPTION_KEY=

# ---- Payments (Paystack) ----
# Empty = simulated checkout for demos. sk_test_/pk_test_ for testing, sk_live_/pk_live_ for real money.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- First admin, created on first start if no admin exists ----
ADMIN_EMAIL=admin@tillwemeet.com
ADMIN_PASSWORD=
