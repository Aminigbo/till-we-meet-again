# tillwemeet: settings for the LIVE site.
# Copy this file to .env.production on your server (or enter the same values in your host's
# environment settings, e.g. Cloud Run → Edit → Variables & secrets) and fill in every value.
# The app refuses to start in production if the database, SESSION_SECRET or ENCRYPTION_KEY is missing.

NODE_ENV=production
PORT=8080
# Your public https address, no trailing slash. Used in share links, cards, Paystack and cookies.
BASE_URL=https://tillwemeet.com

# ---- Firebase (required) ----
# Project settings → General → Project ID
FIREBASE_PROJECT_ID=
# Project settings → Service accounts → Generate new private key. Path to the JSON file on the server,
# or the JSON itself on one line. Leave empty on Cloud Run: it uses the service's own identity.
FIREBASE_SERVICE_ACCOUNT=
# Build → Storage → bucket name without "gs://", e.g. your-project.firebasestorage.app
# Required on hosts without a permanent disk (Cloud Run, Render, Railway), or uploads are lost on restart.
FIREBASE_STORAGE_BUCKET=

# ---- Security (required) ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep ENCRYPTION_KEY safe and never change it: it decrypts the NINs already stored.
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- Payments (required to take money) ----
# dashboard.paystack.com → Settings → API Keys & Webhooks. Use the LIVE keys (sk_live_..., pk_live_...).
# Set the callback URL to  https://YOUR-DOMAIN/payments/callback
# and the webhook URL to   https://YOUR-DOMAIN/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- First admin (used once, on first start, if no admin exists yet) ----
ADMIN_EMAIL=
# Use a strong password, then sign in and change it under My account → Settings.
ADMIN_PASSWORD=
