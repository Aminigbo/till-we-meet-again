rules_version = '2';
// tillwemeet reads and writes Firestore only from its server, using the Admin SDK
// (which isn't bound by these rules). Browsers never talk to Firestore directly,
// so all direct client access is refused. This keeps NINs, certificates and
// payment records safe even if someone finds your Firebase config.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
